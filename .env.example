# Server Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Option 1: Unified Connection String (Recommended)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rs_awal_bros_kb

# Option 2: Discrete PostgreSQL Parameters (Used if DATABASE_URL is omitted)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rs_awal_bros_kb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Database Pool Configuration (Optional tuning)
# DB_POOL_MAX=15
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Disaster Recovery & Automated Backups (M12)
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=7

# Bootstrap Administrator Account (Optional - used by: npm run seed:admin)
# Defaults applied if omitted: admin.it / AwalBrosIT@2026
ADMIN_USERNAME=admin.it
ADMIN_PASSWORD=AwalBrosIT@2026
ADMIN_FULL_NAME=Super Administrator IT
ADMIN_EMAIL=admin.it@awalbros.com

# Authentication (JWT Secret - keep secure and private)
# Development: fallback default is permitted
# Production: REQUIRED! Must be at least 32 characters.
# Insecure defaults (e.g. awal-bros-botania-prod-jwt-secret-min-32-chars) are strictly rejected.
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters

# External AI Service (Google Gemini API Key - Optional)
# If left blank, AI queries will gracefully fall back to local PostgreSQL SOP data
GEMINI_API_KEY=
